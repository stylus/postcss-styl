{
    "eslint.validate": [
        "javascript","json","jsonc"
    ],
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "explicit",
        "source.fixAll.stylelint": "explicit"
    },
    "[stylus]": {
        "editor.codeActionsOnSave": {
            "source.fixAll.stylelint": "never",
        }
    },
    "stylelint.validate": [
        "css",
        "vue",
        "stylus"
    ]
}